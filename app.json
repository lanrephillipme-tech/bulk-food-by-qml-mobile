{
  "expo": {
    "name": "Bulk Food by QML",
    "slug": "bulk-food-by-qml-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "bulkfoodqml",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/onboarding/launch.png",
      "backgroundColor": "#FFFFFF",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "com.qml.bulkfood",
      "supportsTablet": true
    },
    "android": {
      "package": "com.qml.bulkfood",
      "adaptiveIcon": {
        "backgroundColor": "#138A36"
      },
      "splash": {
        "image": "./assets/onboarding/launch.png",
        "backgroundColor": "#FFFFFF",
        "resizeMode": "contain"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "eas": {
        "projectId": "b7bf1dfd-a67b-40c0-a395-006a64dfe53f"
      }
    },
    "owner": "vidalpaybank",
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/onboarding/launch.png",
          "imageWidth": 240,
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-notifications"
    ]
  }
}
